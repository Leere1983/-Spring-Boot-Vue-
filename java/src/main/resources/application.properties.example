# ============================================================
#  在线拍卖平台 - 后端配置模板
# ------------------------------------------------------------
#  使用方法：
#      1. 复制本文件为 application.properties
#         copy application.properties.example application.properties
#      2. 按本机环境填写下面的真实值
#  说明：application.properties 已被 .gitignore 忽略，
#        含密钥的真实配置不会被提交到版本库。
# ============================================================


# ---------------------- 数据库 ----------------------
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.username=root
spring.datasource.password=
# 注意：请按本机 MySQL 端口填写（原开发环境使用的是 3309）
spring.datasource.url=jdbc:mysql://localhost:3306/bishe?useUnicode=true&characterEncoding=UTF-8&useSSL=FALSE&serverTimezone=UTC&useOldAliasMetadataBehavior=true

# 数据源与连接池配置
spring.datasource.type=com.zaxxer.hikari.HikariDataSource
spring.datasource.hikari.minimum-idle=20
spring.datasource.hikari.maximum-pool-size=100
spring.datasource.hikari.auto-commit=true
spring.datasource.hikari.idle-timeout=30000
spring.datasource.hikari.pool-name=DatebookHikariCP
spring.datasource.hikari.max-lifetime=1800000
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.connection-test-query=SELECT 1

# 连接泄露检测（可选开启）
#spring.datasource.hikari.register-mbeans=true
#spring.datasource.hikari.leakDetectionThreshold=5000


# ---------------------- MVC ----------------------
spring.mvc.view.prefix=/
spring.mvc.view.suffix=.jsp


# ---------------------- 服务器 ----------------------
server.port=8080
server.servlet.context-path=/
# 关闭 Whitelabel 错误页
server.error.whitelabel.enabled=false
# 错误响应包含堆栈信息
server.error.include-stacktrace=always


# ---------------------- 文件上传 ----------------------
spring.servlet.multipart.maxFileSize=-1
spring.servlet.multipart.maxRequestSize=-1


# ---------------------- 其他 ----------------------
jntoo.db.debug=true
admin.account=admin


# ---------------------- 支付宝沙箱 ----------------------
# 在 https://open.alipay.com/develop/sandbox/app 申请沙箱应用后填写
# 沙箱买家/卖家账号同样在沙箱控制台中查看
alipay.app-id=
alipay.merchant-private-key=
alipay.alipay-public-key=
alipay.gateway-url=https://openapi-sandbox.dl.alipaydev.com/gateway.do
alipay.notify-url=http://localhost:8080/api/alipay/notify
alipay.return-url=http://localhost:8080/api/alipay/return
# 前端跳转地址（当前轮询模式下暂未使用）
# alipay.front-success-url=http://localhost:5174/admin/sy


# ---------------------- AI 问答 ----------------------
# 阿里云百炼（DashScope）兼容模式，密钥在其控制台创建
ai.enabled=true
ai.api-base=https://dashscope.aliyuncs.com/compatible-mode/v1
ai.api-key=
ai.model=qwen-turbo
